{
  "name": "procure-ledger-webhook-consumer-nest",
  "version": "1.0.0",
  "private": true,
  "description": "ProcureLedger 서명 알림(웹훅) 수신기 예제: 서명 검증, 이벤트 번호 멱등, 변경 피드 재조회",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
