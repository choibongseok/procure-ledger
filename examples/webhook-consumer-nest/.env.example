# 수신기 설정(환경변수). 비밀·토큰은 파일에 적지 말고 셸이나 비밀 저장소로 넘깁니다.
PORT=3000
# ProcureLedger 서버 주소와 연동 토큰(changes:read 범위, pli_ 로 시작)
PL_API_BASE_URL=http://127.0.0.1:8080
PL_API_TOKEN=
# 웹훅 구독을 등록할 때 한 번만 보이는 서명 비밀(whsec_ 로 시작)
PL_WEBHOOK_SECRET=
# 비밀을 교체하는 24시간 동안만 옛 비밀을 함께 둔다(선택)
PL_WEBHOOK_SECRET_PREVIOUS=
# 서명 시각 허용 오차(초). 서버 시계를 NTP 로 맞춘다는 전제의 기본값 300
PL_WEBHOOK_TOLERANCE_SECONDS=300
# 저장소: memory(기본) 또는 postgres
PL_STORE=memory
DATABASE_URL=
# 저장된 커서가 없을 때 어디서부터 읽을지: head(지금부터, 기본) 또는 start(처음부터)
PL_INITIAL_CURSOR=head
