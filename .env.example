# ProcureLedger 환경변수 예시. 복사해서 .env 로 쓰고 값을 채운다(.env 는 gitignore, 비밀값은 커밋하지 않는다).
# 서버는 .env 파일을 직접 읽지 않는다. 셸에서 `set -a; . ./.env; set +a` 로 내보내거나
# `docker run --env-file .env` 로 넘긴다(--env-file 은 따옴표를 값으로 취급하니 따옴표를 쓰지 않는다).

# ---- 서버 ----
# 대기 주소. 기본 :8080
PL_ADDR=:8080
# SQLite 파일 경로. 컨테이너는 /data/erp.db(볼륨). 기본 data/erp.db
PL_DB_PATH=data/erp.db
# PostgreSQL 을 쓰려면 postgres:// 주소를 지정한다(비우면 위 SQLite 파일). 원격 호스트는 sslmode=verify-full 필수. 비밀번호가 들어 있으니 비밀 저장소에서 주입한다.
# 예: postgres://pl:<비밀번호>@db.internal:5432/procure?sslmode=verify-full
PL_DB_URL=
PL_DB_MAX_CONNS=10
# 1 이면 루프백 호스트의 평문 PostgreSQL 연결을 허용한다(로컬 개발 전용).
PL_DB_ALLOW_INSECURE=
# 사용자가 브라우저로 접속하는 주소. OIDC 리다이렉트·dev IdP 발급자 주소의 기준. 비우면 PL_ADDR 에서 만든다.
# https 로 시작하면 세션 쿠키에 Secure 가 자동으로 붙는다.
PL_BASE_URL=
# 1 이면 세션 쿠키에 Secure 를 강제한다(https 종단 뒤에서 BASE_URL 이 http 일 때).
PL_COOKIE_SECURE=

# ---- 로그인(OIDC) ----
# 로컬 검증용 dev IdP. 1 로 켜면 비밀번호 없는 시드 계정으로 로그인된다. 운영에서는 비워 둔다(꺼짐).
# PL_BASE_URL 이 로컬 주소(localhost·127.0.0.1·::1)가 아니면 기동이 실패하고, 외부 IdP(PL_OIDC_ISSUER)와 같이 켜도 실패한다.
PL_DEV_IDP=
# 외부 IdP. ISSUER 를 설정하면 표준 Authorization Code + PKCE 로 로그인한다.
PL_OIDC_ISSUER=
PL_OIDC_CLIENT_ID=
# 클라이언트 시크릿은 비밀 저장소에서 주입하고 이 파일에는 실제 값을 적지 않는다.
PL_OIDC_CLIENT_SECRET=
# 비우면 PL_BASE_URL/api/auth/callback. IdP 에도 같은 주소를 등록한다.
PL_OIDC_REDIRECT_URL=

# ---- 감사 체인 외부 앵커(docs/deploy-checklist.md 참고) ----
# 체인 머리 해시를 HMAC 서명해 DB 밖 파일에 덧붙인다. 키를 비워 두면 기능이 꺼지고 검증 화면이 "외부 대조 없음"을 보인다.
# 키는 16바이트 이상의 무작위 값을 비밀 저장소에서 주입한다(이 파일에는 실제 값을 적지 않는다).
PL_AUDIT_ANCHOR_KEY=
# 앵커 파일 경로. 키가 있으면 필수이고 쓸 수 없으면 기동이 거부된다. DB 와 다른 볼륨·권한에 둔다.
PL_AUDIT_ANCHOR_PATH=
# 주기 기록 간격(Go 기간 형식). 기본 5m, 0 이면 주기 기록 없음(종료 시 한 번과 수동 기록만).
PL_AUDIT_ANCHOR_INTERVAL=5m

# ---- AI 연결(MCP) 사용 한도(B13) ----
# 개인 토큰 하나의 분당 MCP 호출 한도. 0(기본)이면 한도 없음. 초과 호출은 거부되고 감사 로그에 남는다.
PL_MCP_RATE_PER_MIN=0
# 사용자 한 명의 모든 개인 토큰을 합친 분당 호출 한도(토큰별 한도에 더해 적용). 0(기본)이면 사용자 합산 한도 없음.
PL_MCP_RATE_PER_USER_PER_MIN=0
# 사용자당 유효(폐기·만료 아님) 개인 토큰 개수 상한. 기본 10, 0 이면 상한 없음. 상한에서 발급하면 거부된다.
PL_MAX_ACTIVE_TOKENS=10
# SCIM 연동(B40). 같은 출처(IdP)의 유효 연동 토큰 상한(기본 2: 교체 중에 새 토큰과 옛 토큰이 함께 있을 수 있다), 토큰당 분당 호출 한도(기본 600, 0 이면 한도 없음), 동기화 기록 보존 일수(기본 365).
PL_SCIM_MAX_ACTIVE_TOKENS=2
PL_SCIM_RATE_PER_MIN=600
PL_SCIM_LOG_KEEP_DAYS=365
# SCIM 요청을 받을 출발지 주소(쉼표로 구분한 CIDR 또는 IP, 예: 20.0.0.0/8,203.0.113.7). 비우면 제한 없음. 연결 상대 주소로만 판정하므로 프록시 뒤에서는 프록시 주소가 보인다.
PL_SCIM_ALLOW_CIDR=
# 연동 REST API(/api/v1, B42). 허용 출발지(쉼표로 구분한 CIDR 또는 IP, 비우면 제한 없음, 토큰마다 더 좁게 정할 수 있다), 유효 토큰 상한(기본 5), 서버 전체 동시 요청 상한(기본 32),
# 토큰당 분당 읽기 호출 한도의 기본값(기본 600, 관리 화면에서 바꾸면 화면 설정이 우선). API 켜기·끄기는 환경변수가 아니라 관리 화면 설정이다. 복구 리허설 모드에서는 꺼진다.
PL_API_ALLOW_CIDR=
PL_API_MAX_ACTIVE_TOKENS=5
PL_API_MAX_CONCURRENT=32
PL_API_RATE_PER_MIN=600
# 커넥터 예시(erp-admin connector run)가 연동 API 를 부를 때 쓰는 토큰 원문. 파일이나 명령 인자에 적지 않고 실행하는 셸 환경에서만 넘긴다(여기에는 비워 둔다).
PL_CONNECTOR_TOKEN=

# ---- LLM 게이트웨이(설명은 evals/README.md) ----
# mock(기본, 결정적) 또는 anthropic
PL_LLM_PROVIDER=mock
# 모델 ID. 코드에 기본값이 없다. anthropic 이면 필수(권장 시작값은 evals/README.md 참고).
PL_LLM_MODEL=
# API 키를 읽을 환경변수 이름(기본 ANTHROPIC_API_KEY). 키 자체는 여기에 적지 않는다.
PL_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
# 1백만 토큰당 가격(1e-6 USD 정수). 비면 비용 0 으로 기록한다.
PL_LLM_PRICE_IN_MICRO_PER_MTOK=
PL_LLM_PRICE_OUT_MICRO_PER_MTOK=

# ---- MCP 단독 실행(cmd/erp-mcp --transport stdio) ----
# 개인 토큰 화면에서 발급한 토큰. 호출자 신원과 권한은 이 토큰의 소유자 기준이다.
PL_MCP_TOKEN=

# ---- 사내 규정 검색(B12) ----
# 규정 문서(마크다운) 폴더. 비우면 바이너리에 내장된 docs/policies 를 쓴다. 지정하면 그 폴더를 읽고 내용이 바뀌면 다시 색인한다.
PL_POLICY_DIR=

# 결재 문서 첨부 상한(B23, DB 에 저장). 파일당 바이트(기본 10MB), 문서당 개수(기본 20), 문서 합계 바이트(기본 50MB).
# 첨부가 쌓이면 SQLite 파일이 커지고 백업·복원이 느려지므로 운영에서는 상한을 낮추는 것을 검토한다.
PL_ATTACH_MAX_FILE_BYTES=10485760
PL_ATTACH_MAX_FILES=20
PL_ATTACH_MAX_TOTAL_BYTES=52428800

# 목록·보고서 엑셀(XLSX)·CSV 내보내기의 1회 상한 행 수(B28). 기본 10000, 허용 100~100000. 범위 밖이면 기동이 거부된다.
# 조건에 맞는 자료가 상한을 넘으면 자르지 않고 거부하며 조건을 좁히라고 안내한다.
PL_EXPORT_MAX_ROWS=10000

# ---- 로그인 방식(B30) ----
# 비밀번호 재설정·설정 링크 메일(SMTP). HOST 를 비우면 메일 발송이 꺼지고, 비밀번호는 관리자가 임시 비밀번호로 시작·초기화한다.
# TLS 없는 연결은 거부된다(포트 465 는 암묵 TLS, 그 밖은 STARTTLS 필수).
PL_SMTP_HOST=
PL_SMTP_PORT=587
PL_SMTP_USER=
# SMTP 비밀번호는 비밀 저장소에서 주입하고 이 파일에는 실제 값을 적지 않는다.
PL_SMTP_PASSWORD=
PL_SMTP_FROM=
# 1 이면 TLS 없는 SMTP 를 허용한다. 로컬 시험 전용이며 PL_BASE_URL 이 로컬이 아니면 기동이 실패한다.
PL_SMTP_INSECURE=
# 비밀번호 해시(argon2id) 비용 조정(선택). 0·빈 값은 기본(메모리 65536 KiB·반복 3·병렬 2). 올려도 기존 해시는 계속 검증되고 로그인 때 새 값으로 다시 해시된다.
PL_AUTH_PASSWORD_ARGON_MEM_KIB=
PL_AUTH_PASSWORD_ARGON_TIME=
PL_AUTH_PASSWORD_ARGON_PAR=
# TOTP 비밀키 암호화용 32바이트 키(base64). 비밀이다: 비밀 저장소에서 주입하고 이 파일에는 실제 값을 적지 않는다.
# 비우면 2단계 인증 기능이 꺼진다(admin 필수 설정이 있어도 요구하지 않는다). 생성: openssl rand -base64 32
# 바꾸면 기존 TOTP 비밀키를 풀 수 없어 전원 재등록이 필요하다(필수 역할은 다음 로그인에서 강제).
PL_AUTH_SECRET_KEY=
# 계좌번호 저장 암호화용 32바이트 키(base64). 비밀이다: 비밀 저장소에서 주입하고 이 파일에는 실제 값을 적지 않는다. 생성: openssl rand -base64 32
# 비우면 기동은 하지만 거래처·회사 계좌번호를 새로 저장할 수 없다(경고 로그). 기존 평문 계좌번호는 키를 넣고 기동하면 한 번 암호화된다.
# 바꾸면 이미 암호화된 계좌번호를 풀 수 없다(키 회전은 후속). 인증 키(PL_AUTH_SECRET_KEY)와 따로 둔다: 한쪽을 교체·폐기해도 다른 쪽이 깨지지 않게.
PL_ACCOUNT_SECRET_KEY=
# 알림 웹훅(슬랙·팀즈·카카오워크, B36)의 주소도 위 키(PL_ACCOUNT_SECRET_KEY)로 암호화해 저장한다(용도별 AAD 로 계좌번호와 섞이지 않는다). 키가 없으면 웹훅 대상을 등록할 수 없다.
# 1 이면 알림 웹훅이 루프백 주소(127.0.0.1 등)의 http 로 가는 것을 허용한다. 로컬 시험(모의 웹훅 서버) 전용이며 운영에서는 비운다.
PL_NOTIFY_INSECURE_LOCAL=
# 구글 워크스페이스 로그인(OIDC). 클라이언트 ID·비밀은 Google Cloud 콘솔의 OAuth 클라이언트(웹 애플리케이션)에서 만든다.
# 허용 도메인은 설정 화면(/admin/auth)에서 입력한다. 리디렉션 URI 는 PL_BASE_URL/api/auth/callback.
PL_AUTH_GOOGLE_CLIENT_ID=
# 클라이언트 비밀은 비밀 저장소에서 주입하고 이 파일에는 실제 값을 적지 않는다.
PL_AUTH_GOOGLE_CLIENT_SECRET=
# 마이크로소프트 Entra ID 로그인(OIDC, 단일 테넌트). 앱 등록의 애플리케이션(클라이언트) ID·클라이언트 비밀. 테넌트 ID 는 설정 화면에서 입력한다.
PL_AUTH_MS_CLIENT_ID=
# 클라이언트 비밀은 비밀 저장소에서 주입하고 이 파일에는 실제 값을 적지 않는다. 만료일이 있으니 갱신을 잊지 않는다.
PL_AUTH_MS_CLIENT_SECRET=

# 개발 시드 계정의 이메일 로그인 초기 비밀번호(개발·시연 전용). dev IdP 를 켤 수 없는 https 미리보기에서 쓴다. 비밀이다: 이 파일에는 실제 값을 적지 않는다.
# 값이 있으면 개발 시드(사용자·조직)가 들어가고, 이메일 로그인 자격이 없는 시드 계정에 이 값으로 자격을 만든다(첫 로그인에서 변경 강제).
# 10자 이상·영문 대·소문자·숫자·기호 중 3종류 이상이 아니면 기동이 거부된다. 개발 시드 밖의 사용자가 있는 DB(운영)에서는 경고하고 무시한다. 운영에서는 비워 둔다.
PL_DEV_SEED_PASSWORD=
# 설치 마법사(빈 DB 첫 기동 때만 열림)의 설치 코드를 직접 정한다(비밀, 16자 이상). 비우면 기동할 때마다 무작위 코드를 만들어 서버 로그(표준 출력)에만 한 번 출력한다.
# 로그를 외부로 수집하는 환경이나 자동 설치에서 별도 채널로 전달할 때 쓴다. 설치가 끝나면 쓰이지 않는다.
PL_SETUP_CODE=
# 백업·복구(erp-admin backup·restore). 백업 세트를 두는 디렉터리(기본: DB 파일 옆 backups/, 다른 디스크를 권장한다).
PL_BACKUP_DIR=
# 백업 암호화 키(비밀, 16자 이상). erp-admin backup --encrypt 와 암호화 세트의 verify-backup·restore 에 필요하다. 백업과 따로 보관한다(잃으면 복구할 수 없다).
PL_BACKUP_KEY=
# 보존할 백업 세트 개수(2 이상, 기본 14). 새 백업이 검증을 통과한 뒤에만 오래된 세트를 지운다.
PL_BACKUP_KEEP=
# PostgreSQL 백업·복구에 쓰는 pg_dump 경로(비우면 PATH). pg_restore 는 같은 디렉터리에서 찾는다. 컨테이너 이미지에는 없으므로 호스트나 사이드카에서 실행한다.
PL_PG_DUMP=
# 복구 리허설 모드(1). erp-admin restore --rehearse·scripts/restore-rehearsal.sh 가 임시 위치의 복구본에서 서버를 띄울 때만 켠다. 주기 작업·메일/웹훅 발송·감사 앵커 기록을 하지 않는다.
# os.TempDir() 아래이거나 .rehearsal 마커가 있는 디렉터리의 SQLite 에서만 허용되고, 운영 경로나 PL_DB_URL(PostgreSQL)에서는 기동을 거부한다. 운영에서는 비운다.
PL_REHEARSAL=
# SAML 2.0 SP 서명·복호화용 인증서·키 파일 경로(PEM). 키 파일은 저장소 밖에 두고 권한 0600 이어야 한다(아니면 SAML 이 꺼진 채 시작). 키는 RSA.
# 인증서는 SP 메타데이터(/api/auth/saml/metadata)로 IdP 에 전달된다. 생성: openssl req -x509 -newkey rsa:2048 -nodes -keyout sp.key -out sp.crt -days 730 -subj "/CN=procure-ledger-sp"
PL_SAML_SP_CERT_PATH=
PL_SAML_SP_KEY_PATH=
